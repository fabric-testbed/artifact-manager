# Nginx site config template.
#
# Rendered at container start by the official nginx image's envsubst entrypoint:
# mounted at /etc/nginx/templates/default.conf.template, written to
# /etc/nginx/conf.d/default.conf. NGINX_ENVSUBST_FILTER is set to ^AMGR_ in the compose
# file, so only ${AMGR_*} placeholders below are substituted and Nginx's own runtime
# variables ($host, $request_uri, $scheme, ...) pass through untouched.
#
# Every AMGR_* value is defined in .env - see env.template.

# the upstream component nginx needs to connect to
upstream django {
    # use for local-ssl deployment
    #server host.docker.internal:8000; # TCP socket
    # use for docker deployment
    server amgr-django:8000;
}

server {
    listen 80;
    return 301 https://$host:${AMGR_HTTPS_PORT}$request_uri;
}

server {
    listen   443 ssl default_server;
    # the domain name it will serve for
    server_name $host:${AMGR_HTTPS_PORT};

    # Enable support for TLS 1.2 and/or 1.3
    ssl_protocols  TLSv1.2 TLSv1.3;

    # If they come here using HTTP, bounce them to the correct scheme
    error_page 497 https://$server_name$request_uri;
    # Or if you're on the default port 443, then this should work too
    # error_page 497 https://;

    # Certificate filenames, resolved inside NGINX_SSL_CERTS_DIR (mounted at /etc/ssl).
    # ssl_trusted_certificate is omitted: it only matters for OCSP stapling and client
    # certificate verification, neither of which is enabled here.
    ssl_certificate           /etc/ssl/${AMGR_SSL_CERT};
    ssl_certificate_key       /etc/ssl/${AMGR_SSL_CERT_KEY};

    charset     utf-8;

    # set max header size
    large_client_header_buffers 4 32k;

    # max upload size
    client_max_body_size ${AMGR_CLIENT_MAX_BODY_SIZE};

    # Cache configuration
    open_file_cache max=1000 inactive=20s;
    open_file_cache_valid 30s;
    open_file_cache_min_uses 5;
    open_file_cache_errors off;

    location = /validate {
        # forward the /validate request to Vouch Proxy
        proxy_pass http://vouch-proxy:9090/validate;

        # be sure to pass the original host header
        proxy_set_header Host $http_host;

        # Vouch Proxy only acts on the request headers
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";

        ### AUTH REQUEST SET ###
        # optionally add X-Vouch-User as returned by Vouch Proxy along with the request
        auth_request_set $auth_resp_x_vouch_user $upstream_http_x_vouch_user;

        # optinally add X-Vouch-IdP-IdToken, X-Vouch-IdP-AccessToken or X-Vouch-IdP-RefreshToken
        auth_request_set $auth_resp_x_vouch_idp_idtoken $upstream_http_x_vouch_idp_idtoken;
        #auth_request_set $auth_resp_x_vouch_idp_accesstoken $upstream_http_x_vouch_idp_accesstoken;
        #auth_request_set $auth_resp_x_vouch_idp_refreshtoken $upstream_http_x_vouch_idp_refreshtoken;
    }

    # Login is application-directed, not enforced here. Django's LOGIN_URL is a bare /login and
    # the navbar links to it; the /login location below supplies the url= parameter Vouch needs.
    #
    # The upstream Vouch recipe's `error_page 401 = @error401` block is deliberately absent.
    # Vouch runs with publicAccess: true, so /validate accepts every request and the auth_request
    # below never yields a 401 for it to catch. It would also have been wrong if it did fire: the
    # /login location's proxy_pass carries its own query string, so nginx replaces the request's
    # args rather than merging them, and the url= / vouch-failcount= / X-Vouch-Token= that block
    # assembled would have been discarded before reaching Vouch.

    location /auth {
        # redirect to Vouch Proxy for authentication with OIDC client
        # Callback URL (relative to host) must be defined in both OIDC client and vouch/config
        proxy_pass http://vouch-proxy:9090/auth;
    }

    location /login {
        # redirect to Vouch Proxy for login
        proxy_pass http://vouch-proxy:9090/login?url=$scheme://$http_host;
    }

    location /logout {
        # redirect to Vouch Proxy for logout
        proxy_pass http://vouch-proxy:9090/logout?url=$scheme://$http_host;
    }

    # Artifact bundle downloads handed off by Django via X-Accel-Redirect.
    # Django authorizes the request and returns this path in a header; Nginx sends the
    # bytes with sendfile(), freeing the uWSGI worker immediately. `internal` means the
    # location cannot be requested directly by a client.
    location ${AMGR_X_ACCEL_LOCATION} {
        internal;
        alias ${AMGR_ARTIFACT_STORAGE_PATH}/;
    }

    # Django media
    location /media  {
        alias /code/media;  # your Django project's media files - amend as required
    }

    location /static {
        alias /code/static; # your Django project's static files - amend as required
    }

    # Finally, send all non-media requests to the Django server.
    location / {
        # CORS - accept all preflight OPTIONS checks
        add_header 'Access-Control-Allow-Credentials' 'true';
        add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, PATCH, DELETE, OPTIONS';
        add_header 'Access-Control-Allow-Headers' 'DNT, User-Agent, X-Requested-With, If-Modified-Since, Cache-Control, Content-Type, Range';
        add_header 'Access-Control-Max-Age' 1728000;

        # send all requests to the `/validate` endpoint for authorization
        auth_request /validate;
        proxy_set_header X-Vouch-User $auth_resp_x_vouch_user;

        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Host $http_host;
        proxy_redirect off;

        proxy_buffers 8 24k;
        proxy_buffer_size 2k;
        uwsgi_pass  django;
        include     /code/uwsgi_params; # the uwsgi_params file
    }
}
